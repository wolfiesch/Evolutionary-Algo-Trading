# Crypto Alpha System Configuration
# Copy this to .env and fill in your values

# Discord Webhook for notifications (required for monitoring)
# Create at: Discord Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Optional: Batch trade notifications (reduces noise)
DISCORD_BATCH_TRADES=false
DISCORD_BATCH_INTERVAL=300

# Bybit API (read-only for Phase 1 - not required yet)
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
