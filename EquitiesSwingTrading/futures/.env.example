# IBKR Configuration
# Copy to .env and customize

# Connection settings
IBKR_HOST=127.0.0.1
IBKR_PAPER_PORT=7497    # TWS paper trading
IBKR_LIVE_PORT=7496     # TWS live trading (use with caution!)
IBKR_CLIENT_ID=1        # Unique client ID (change if running multiple connections)

# Trading mode
IBKR_USE_PAPER=true     # Set to false for live trading (dangerous!)
IBKR_READONLY=false     # Set to true for data-only mode (no orders)

# Enabled contracts (comma-separated)
FUTURES_SYMBOLS=MES,MNQ
